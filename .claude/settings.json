{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet run --project src/Arts6311.Tests:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet ef migrations list:*)",
      "Bash(dotnet ef migrations add:*)",
      "Bash(dotnet ef migrations has-pending-model-changes:*)",
      "Bash(npm ci:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(aspire run:*)",
      "Bash(aspire add:*)",
      "Bash(aspire publish:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(rg:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh workflow run:*)",
      "Bash(dotnet ef database update:*)",
      "PowerShell(git push:*)",
      "PowerShell(gh pr merge:*)",
      "PowerShell(gh workflow run:*)",
      "PowerShell(dotnet ef database update:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(dotnet ef database drop:*)",
      "Bash(aspire deploy:*)",
      "Bash(aspire destroy:*)",
      "Bash(aspire do:*)",
      "Bash(azd up:*)",
      "Bash(azd deploy:*)",
      "Bash(azd provision:*)",
      "Bash(azd down:*)",
      "Bash(az group delete:*)",
      "Bash(az deployment:*)",
      "Bash(az containerapp:*)",
      "Bash(az webapp deploy:*)",
      "Bash(swa deploy:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(dotnet ef database drop:*)",
      "PowerShell(aspire deploy:*)",
      "PowerShell(aspire destroy:*)",
      "PowerShell(aspire do:*)",
      "PowerShell(azd up:*)",
      "PowerShell(azd deploy:*)",
      "PowerShell(azd provision:*)",
      "PowerShell(azd down:*)",
      "PowerShell(az group delete:*)",
      "PowerShell(az deployment:*)",
      "PowerShell(az containerapp:*)",
      "PowerShell(az webapp deploy:*)",
      "PowerShell(swa deploy:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/secrets.json)",
      "Read(~/AppData/Roaming/Microsoft/UserSecrets/**)",
      "Read(~/.microsoft/usersecrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/secret-guard.sh",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/format.sh"
          }
        ]
      }
    ]
  }
}
