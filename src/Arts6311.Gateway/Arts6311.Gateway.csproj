<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery.Yarp" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>

  <!--
    ServiceDefaults is the gateway's only project reference, and ProjectReferenceTests pins it there: the
    gateway holds no domain code (gateway.md "Not the gateway's job"). That is why it mirrors the internal-token
    constants rather than sharing the API's copy (ADR 0022).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Arts6311.ServiceDefaults\Arts6311.ServiceDefaults.csproj" />
  </ItemGroup>

  <!-- WebApplicationFactory<GatewayHost> needs the internal marker of a top-level-statements host. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Arts6311.Tests" />
  </ItemGroup>

</Project>
