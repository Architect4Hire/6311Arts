{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },

  "Gateway": {
    "TrustedProxies": [],
    "Csp": {
      "Default": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo=' 'sha256-VM2mZqyEQZoLzoTrp5EigFvzQ0+f1wSeBuoOn95WHCg=' 'sha256-WAFInstuijDmkdZL9gTCFeDmZQw9HbGd+IA1OUdNqjo='; connect-src 'self'; font-src 'self' https://fonts.gstatic.com; form-action 'self'",
      "Referrer": "strict-origin-when-cross-origin",
      "Overrides": {}
    },
    "Session": {
      "CookieName": "__Host-6311.session",
      "Staff": { "IdleTimeout": "00:30:00", "AbsoluteTimeout": "08:00:00" },
      "Member": {
        "IdleTimeout": "7.00:00:00",
        "AbsoluteTimeout": "30.00:00:00"
      },
      "RevalidationInterval": "00:05:00",
      "LoginPath": "/signin"
    },
    "AccountEmail": {
      "Cooldown": "00:05:00",
      "QueueCapacity": 256
    },
    "GlobalRateLimit": {
      "PermitLimit": 600,
      "Window": "00:01:00",
      "QueueLimit": 0
    },
    "RateLimits": {
      "bff-login": { "PermitLimit": 10, "Window": "00:05:00", "QueueLimit": 0 },
      "bff-account": {
        "PermitLimit": 10,
        "Window": "00:05:00",
        "QueueLimit": 0
      },
      "forms": { "PermitLimit": 10, "Window": "00:05:00", "QueueLimit": 0 },
      "forms-submissions": { "PermitLimit": 3, "Window": "01:00:00", "QueueLimit": 0 },
      "checkout": { "PermitLimit": 20, "Window": "00:01:00", "QueueLimit": 0 },
      "webhooks": { "PermitLimit": 240, "Window": "00:01:00", "QueueLimit": 0 },
      "api": { "PermitLimit": 300, "Window": "00:01:00", "QueueLimit": 0 }
    }
  },

  "ReverseProxy": {
    "Routes": {
      "webhooks-square": {
        "ClusterId": "api",
        "Match": {
          "Path": "/webhooks/square",
          "Methods": ["POST"]
        },
        "MaxRequestBodySize": 262144,
        "RateLimiterPolicy": "webhooks"
      },
      "media": {
        "ClusterId": "api",
        "Match": {
          "Path": "/media/{**rest}",
          "Methods": ["GET", "HEAD"]
        }
      },
      "forms-submissions": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/v1/forms/submissions",
          "Methods": ["POST"]
        },
        "MaxRequestBodySize": 67108864,
        "RateLimiterPolicy": "forms-submissions"
      },
      "forms": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/v1/forms/{**rest}"
        },
        "RateLimiterPolicy": "forms"
      },
      "cms-media-upload": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/v1/cms/media",
          "Methods": ["POST"]
        },
        "AuthorizationPolicy": "CmsEditor",
        "MaxRequestBodySize": 27262976,
        "RateLimiterPolicy": "api"
      },
      "cms": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/v1/cms/{**rest}"
        },
        "AuthorizationPolicy": "CmsEditor",
        "RateLimiterPolicy": "api"
      },
      "api": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/{**rest}"
        },
        "RateLimiterPolicy": "api"
      },
      "admin": {
        "ClusterId": "admin",
        "Match": {
          "Path": "/admin/{**rest}"
        },
        "AuthorizationPolicy": "CmsEditor"
      },
      "site": {
        "ClusterId": "site",
        "Match": {
          "Path": "/{**rest}"
        }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "api": { "Address": "https+http://api" }
        }
      },
      "admin": {
        "Destinations": {
          "admin": { "Address": "https+http://admin" }
        }
      },
      "site": {
        "Destinations": {
          "site": { "Address": "https+http://site" }
        }
      }
    }
  }
}
