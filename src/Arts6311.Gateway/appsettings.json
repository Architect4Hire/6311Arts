{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Gateway": {
    "TrustedProxies": [],
    "Csp": {
      "Default": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; form-action 'self'",
      "Referrer": "strict-origin-when-cross-origin",
      "Overrides": {}
    },
    "GlobalRateLimit": {
      "PermitLimit": 600,
      "Window": "00:01:00",
      "QueueLimit": 0
    },
    "RateLimits": {
      "bff-login": { "PermitLimit": 10, "Window": "00:05:00", "QueueLimit": 0 },
      "forms": { "PermitLimit": 10, "Window": "00:05:00", "QueueLimit": 0 },
      "checkout": { "PermitLimit": 20, "Window": "00:01:00", "QueueLimit": 0 },
      "webhooks": { "PermitLimit": 240, "Window": "00:01:00", "QueueLimit": 0 },
      "api": { "PermitLimit": 300, "Window": "00:01:00", "QueueLimit": 0 }
    }
  },

  "ReverseProxy": {
    "Routes": {
      "webhooks-square": {
        "ClusterId": "api",
        "Match": {
          "Path": "/webhooks/square",
          "Methods": ["POST"]
        },
        "MaxRequestBodySize": 262144,
        "RateLimiterPolicy": "webhooks"
      },
      "media": {
        "ClusterId": "api",
        "Match": {
          "Path": "/media/{**rest}"
        }
      },
      "api": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/{**rest}"
        },
        "RateLimiterPolicy": "api"
      },
      "admin": {
        "ClusterId": "admin",
        "Match": {
          "Path": "/admin/{**rest}"
        }
      },
      "site": {
        "ClusterId": "site",
        "Match": {
          "Path": "/{**rest}"
        }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "api": { "Address": "https+http://api" }
        }
      },
      "admin": {
        "Destinations": {
          "admin": { "Address": "https+http://admin" }
        }
      },
      "site": {
        "Destinations": {
          "site": { "Address": "https+http://site" }
        }
      }
    }
  }
}
