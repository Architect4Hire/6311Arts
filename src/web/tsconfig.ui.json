/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
/* Library tsconfig for @6311/ui, kept at the workspace root beside the app tsconfigs (frontend.md, Workspace config).
   The library is strict even though the site isn't yet; the apps compile its source through the "@6311/ui" path. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "outDir": "./out-tsc/ui",
    "declaration": true,
    "declarationMap": true,
    "types": []
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictStandalone": true
  },
  "include": ["projects/ui/src/**/*.ts"],
  "exclude": ["projects/ui/src/**/*.spec.ts"]
}
