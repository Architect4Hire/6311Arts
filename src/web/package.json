{
  "name": "6311arts-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run start:site",
    "start:site": "node scripts/ng-serve.mjs site",
    "start:admin": "node scripts/ng-serve.mjs admin",
    "build": "npm run build:ui && npm run build:site && npm run build:admin",
    "build:ui": "ng build ui",
    "build:site": "ng build site",
    "build:admin": "ng build admin",
    "build:swa": "ng build site && node -e \"require('fs').copyFileSync('dist/site/browser/index.csr.html','dist/site/browser/index.html')\"",
    "watch": "ng build site --watch --configuration development",
    "test": "ng test ui --watch=false && ng test site --watch=false && ng test admin --watch=false",
    "serve:ssr:site": "node dist/site/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.3",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "jsdom": "^30.1.3",
    "ng-packagr": "^22.2.4",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
