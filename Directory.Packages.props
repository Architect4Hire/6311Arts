<Project>

  <!--
    Central package management. Versions live here only; project files list packages without versions.
    AspireVersion moves together with the Aspire.AppHost.Sdk pin in global.json (.claude/rules/aspire.md).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a PackageVersion below override a vulnerable transitive dependency (see "Security pins"). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <AspireVersion>13.6.1</AspireVersion>
  </PropertyGroup>

  <!--
    Security pins for transitive dependencies. Each names the advisory and when it can go: delete the pin once
    the packages that bring it in ship a patched version themselves.
  -->
  <ItemGroup Label="Security pins">
    <!--
      GHSA-qhrr-8q5h-9q3h (moderate, 2026-10-15): fixed in 2.5.303. Aspire.Hosting 13.6.1 and StreamJsonRpc
      2.25.29 still bring 2.5.302 into the AppHost. Remove when Aspire ships with >= 2.5.303.
    -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <!--
      GHSA-846f-f764-76mx (high) and GHSA-2fmv-rv2c-59x7 (moderate), CVE-2026-84008 / CVE-2026-70162,
      2026-10-13: .NET denial of service, fixed in 10.0.13. Microsoft.Data.SqlClient 7.0.2 (via
      Aspire.Hosting.SqlServer 13.6.1) still brings 10.0.12 into the AppHost. Remove when it ships >= 10.0.13.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="AppHost">
    <PackageVersion Include="Aspire.Hosting.Azure.Sql" Version="13.6.3" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.6.3" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.3" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.6.3" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="$(AspireVersion)" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.MailPit" Version="13.6.0" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Redis.Extensions" Version="13.6.0" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.SqlServer.Extensions" Version="13.6.0" />
  </ItemGroup>

  <ItemGroup Label="API">
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Gateway">
    <!--
      The gateway's session ticket store and its Data Protection key ring, both in Redis (ADR 0009, ADR 0024).
      Redis is the gateway's one piece of state: a ring under the user profile would make every antiforgery token
      die with the process and disagree between replicas.
    -->
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="13.6.3" />
    <!--
      The IDistributedCache HybridCache uses as its L2, in the API and the Worker (ADR 0036): without a shared,
      out-of-process cache, a revalidation in the Worker could not reach the API's entries at all.
    -->
    <PackageVersion Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.6.3" />
    <!--
      The Domain's cache-invalidation channel (ADR 0049): HybridCache reads a tag's invalidation time from L2 once per
      process and keeps it, so the Worker's invalidations reach the API only as a Redis pub/sub message. Pinned to the
      version Aspire.StackExchange.Redis 13.6.2 resolves, so the hosts and the Domain share one client.
    -->
    <PackageVersion Include="StackExchange.Redis" Version="2.13.17" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.13" />
    <!--
      The signing half of the internal token. Pinned to the version Microsoft.AspNetCore.Authentication.JwtBearer
      resolves in the API, so the side that signs and the side that verifies share one IdentityModel (ADR 0002).
    -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="10.11.0" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup Label="Identity and email">
    <!--
      Identity's stores on ArtsDbContext (ADR 0002). Reset and confirmation tokens are Data-Protection-protected,
      and the Worker generates them while the API validates them, so both hosts share one key ring persisted to the
      `dataprotection` blob container (ADR 0023).
    -->
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.4" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.13" />
    <!--
      ITimeLimitedDataProtector, for preview links: a token that expires on its own rather than carrying a date
      this code would have to check (ADR 0036). Same ASP.NET Core version as the DataProtection package above.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <!-- SMTP, in the Worker only: it is the only process that sends email, since every email is an outbox message. -->
    <PackageVersion Include="MailKit" Version="4.18.1" />
  </ItemGroup>

  <ItemGroup Label="Data and caching">
    <PackageVersion Include="Aspire.Azure.Storage.Blobs" Version="13.6.3" />
    <PackageVersion Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.6.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Media">
    <!--
      Image decoding, resizing and encoding for the Media module (ADR 0030). MIT, owned by Microsoft/.NET Foundation;
      chosen over ImageSharp (Six Labors Split License, a commercial licence outside its free tiers) and
      System.Drawing.Common (Windows-only, no WebP). The NoDependencies native asset is the Linux build with no
      fontconfig, for the slim Azure Container Apps image; Windows and macOS assets ship inside SkiaSharp itself.
      The two versions move together.
    -->
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <!-- The `media` container, from the Domain. The version Aspire.Azure.Storage.Blobs $(AspireVersion) brings to the hosts. -->
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.29.2" />
    <!-- The shared HTML sanitizer (Managers/Html, ADR 0034). MIT; brings AngleSharp and AngleSharp.Css (MIT). -->
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
    <!-- Pinned rather than left to HtmlSanitizer's minimums: the Domain compiles against both, and the XSS payload
         suite (HtmlSanitizerTests) is the gate for moving any of the three. -->
    <PackageVersion Include="AngleSharp" Version="1.7.2" />
    <PackageVersion Include="AngleSharp.Css" Version="1.0.2" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Hosting and ServiceDefaults">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
